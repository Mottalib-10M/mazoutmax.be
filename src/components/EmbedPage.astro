---
/** Page embarquable (iframe) : calcul de livraison et tableau du jour, sans navigation. noindex, hors sitemap. */
import '../styles/global.css';
import { LivraisonCalc, TarifJour } from './outils/Tools';
import { SITE_URL, LANG_TAGS, SITE_NAMES } from '../data/site-config';
import { route, type Locale } from '../i18n/routes';
import { REF_DAY, helpers } from '../lib/helpers';
import { EMBED } from '../lib/embed';
interface Props { lang: Locale }
const { lang } = Astro.props;
const H = helpers(lang);
const home = `${SITE_URL}${route('home', lang)}`;
---
<!doctype html>
<html lang={LANG_TAGS[lang]}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{EMBED[lang].title} – widget</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={home} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <LivraisonCalc client:load lang={lang} refDay={REF_DAY} id="embed" />
    <div class="mt-4"><TarifJour client:load lang={lang} refDay={REF_DAY} famille="tout" /></div>
    <p class="mt-2 text-center text-xs text-navy-600"><a href={home} target="_blank" rel="noopener" class="underline">{SITE_NAMES[lang]}</a> · {H.T('tarif officiel relu chez Statbel cinq fois par jour', 'officieel tarief vijf keer per dag bij Statbel opgehaald', 'official tariff read from Statbel five times a day')}</p>
  </body>
</html>
