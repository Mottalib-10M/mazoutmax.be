---
/**
 * Accueil d'une langue (RECETTE §5), ordre propre à ce site : le calcul de la livraison au prix
 * maximum du jour et de demain d'abord (c'est la question), puis le bloc citable replié, le tableau
 * de tous les produits et le texte. Texte dans src/content/accueil.ts.
 */
import PageLayout from '../layouts/PageLayout.astro';
import { LivraisonCalc, TarifJour } from './outils/Tools';
import MiniSim from './calc/MiniSim';
import Clamp from './Clamp.astro';
import { HOME } from '../content/accueil';
import { route, type Locale } from '../i18n/routes';
import { label } from '../i18n/nav';
import { helpers, REF_DAY } from '../lib/helpers';
import { P } from '../lib/engine/params';
import type { SourceKey } from '../lib/engine/params';
import { AUTHOR_NAME } from '../data/site-config';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
interface Props { lang: Locale }
const { lang } = Astro.props;
const x = HOME[lang];
const H = helpers(lang);
const path = route('home', lang);
const parts = x.body(H).split(/<!--(mini:[A-Za-z0-9_]+|tarif:[A-Za-z0-9_]+)-->/);
const resume = x.resume(H);
const faqs = x.faqs(H);
const keys: SourceKey[] = ['bestatJour', 'bestatDernier', 'bestatMois', 'bestatAn', 'statbelLicence', 'chambreContrat', 'fondsPrix', 'fondsMontant'];
const sources = keys.map((k) => ({ name: P.sources[k].label[lang], url: P.sources[k].url }));
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(faqs, lang)];
const by = H.T('Par', 'Door', 'By');
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={faqs} sources={sources}>
  <header class="mb-3">
    <h1 style="hyphens: manual" class="text-[1.75rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{x.h1}</h1>
    <p class="mt-2 text-base text-navy-700 max-sm:text-[0.95rem] sm:text-lg">{x.intro}</p>
  </header>
  <div data-outil><LivraisonCalc client:load lang={lang} refDay={REF_DAY} methodHref={route('method', lang)} id="accueil" /></div>
  <Clamp text={resume} lang={lang} id="clamp-home" sentences={2} class="mt-3" />
  <p class="mt-3 text-sm text-navy-600">{by} <a href={route('about', lang)} class="underline">{AUTHOR_NAME}</a> · <a href={route('method', lang)} class="underline">{label('method', lang)}</a> · <a href={route('mazout-demain', lang)} class="underline">{label('mazout-demain', lang)}</a></p>
  <h2 class="mb-3 mt-8 text-2xl font-bold text-navy-900">{x.calcTitle}</h2>
  <TarifJour client:load lang={lang} refDay={REF_DAY} famille="tout" />
  <div class="prose prose-slate mt-8 max-w-none">
    {parts.map((p, i) => i % 2 === 0 ? <Fragment set:html={p} /> : p.startsWith('tarif:') ? <div data-chrome class="not-prose my-6"><TarifJour client:load lang={lang} refDay={REF_DAY} famille={p.slice(6)} /></div> : <div data-chrome><MiniSim client:load kind={p.slice(5)} lang={lang} href={route('mazout-2000-litres', lang)} /></div>)}
  </div>
</PageLayout>
