---
/** Guides et pages outils en nl : un fichier de `src/content/` = une page (CONTRIBUTING-GUIDES.md). */
import ContentPage from '../../components/ContentPage.astro';
import { PAGES } from '../../lib/guides';
import type { PageDef } from '../../lib/guide-types';
export function getStaticPaths() { return PAGES.map((page) => ({ params: { slug: page.nl.slug }, props: { page } })); }
const { page } = Astro.props as { page: PageDef };
---
<ContentPage page={page} lang="nl" />
